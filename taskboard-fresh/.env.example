# Copy to .env and fill in values.  cp .env.example .env

# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/taskboard

# ─── Auth0 (STUBBED for now — see apps/api/src/middleware/auth.middleware.ts) ──
# When AUTH_MODE=stub, these are ignored and a dev user is resolved from the
# x-dev-user header (or DEV_DEFAULT_USERNAME). Set AUTH_MODE=auth0 to switch on
# the real Auth0 path once credentials below are provided.
AUTH_MODE=stub
DEV_DEFAULT_USERNAME=alice

AUTH0_SECRET=                        # 32+ random bytes: openssl rand -hex 32
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://api.taskboard.app

# ─── API server ──────────────────────────────────────────
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Email (STUBBED — see apps/api/src/lib/email.ts) ─────
# When EMAIL_MODE=stub, emails are logged to the console instead of sent.
EMAIL_MODE=stub
RESEND_API_KEY=
EMAIL_FROM=noreply@taskboard.app

# ─── Waitlist (apps/web/app/api/waitlist) ────────────────
# Signups are added to this Resend audience. If either value is unset the
# waitlist handler stub-logs and still returns success (testable offline).
# Create an audience in the Resend dashboard to get the ID.
RESEND_AUDIENCE_ID=

# ─── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
